<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Civil3DReferencesPath Condition="'$(Civil3DReferencesPath)' == ''">..\C_References</Civil3DReferencesPath>
  </PropertyGroup>
  <Import Project="GeneratedVersion.props" />

  <Target Name="ValidateCivil3DReferences" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(Civil3DReferencesPath)\accoremgd.dll') Or !Exists('$(Civil3DReferencesPath)\AcDbMgd.dll') Or !Exists('$(Civil3DReferencesPath)\acmgd.dll') Or !Exists('$(Civil3DReferencesPath)\AecBaseMgd.dll') Or !Exists('$(Civil3DReferencesPath)\AeccDbMgd.dll') Or !Exists('$(Civil3DReferencesPath)\AeccPressurePipesMgd.dll')"
      Text="Civil 3D 2026 managed references were not found at '$(Civil3DReferencesPath)'. Set /p:Civil3DReferencesPath=&lt;licensed Civil 3D/ObjectARX reference directory&gt;. Autodesk assemblies must not be committed." />
  </Target>

  <ItemGroup>
    <Reference Include="accoremgd">
      <HintPath>$(Civil3DReferencesPath)\accoremgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Acdbmgd">
      <HintPath>$(Civil3DReferencesPath)\AcDbMgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Acmgd">
      <HintPath>$(Civil3DReferencesPath)\acmgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="AecBaseMgd">
      <HintPath>$(Civil3DReferencesPath)\AecBaseMgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="AeccDbMgd">
      <HintPath>$(Civil3DReferencesPath)\AeccDbMgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="AeccPressurePipesMgd">
      <HintPath>$(Civil3DReferencesPath)\AeccPressurePipesMgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!--
    Roslyn for runCode (civil3d_run_code). Civil 3D ships its own copy in the
    AutoCAD folder (2026: 4.10), and one version of an assembly per load
    context means a newer copy of ours could break Civil 3D features that need
    theirs. So: compile against an old version (4.8), do not copy it next to the
    plugin, and ship it in roslyn\ as a fallback that RunCodeCommands loads only
    when Civil 3D has no copy of at least that version (see RoslynResolver).
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" ExcludeAssets="runtime" GeneratePathProperty="true" />
    <PackageReference Include="Microsoft.CodeAnalysis.Common" Version="4.8.0" ExcludeAssets="runtime" GeneratePathProperty="true" />
  </ItemGroup>

  <Target Name="CopyRoslynFallback" AfterTargets="Build">
    <ItemGroup>
      <RoslynFallback Include="$(PkgMicrosoft_CodeAnalysis_Common)\lib\net7.0\Microsoft.CodeAnalysis.dll" />
      <RoslynFallback Include="$(PkgMicrosoft_CodeAnalysis_CSharp)\lib\net7.0\Microsoft.CodeAnalysis.CSharp.dll" />
    </ItemGroup>
    <Error Condition="!Exists('%(RoslynFallback.Identity)')" Text="Roslyn fallback assembly not found: %(RoslynFallback.Identity)" />
    <Copy SourceFiles="@(RoslynFallback)" DestinationFolder="$(OutDir)roslyn" SkipUnchangedFiles="true" />
  </Target>
</Project>
